# Server Configuration
PORT=3000

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here

# LangGraph & LLM Configuration
GEMINI_API_KEY=your_gemini_api_key_here
# Modelo de Gemini para orquestador y soporte. Debe ser un modelo estable (GA), no versiones preview.
GEMINI_MODEL=gemini-3.8-flash

# Guardián nuevo (solo al activar el nuevo flujo; runner --agent real)
AGENT_BURST_SILENCE_MS=8000
AGENT_BURST_MAX_MS=30000
AGENT_SESSION_MS=21600000
AGENT_TURNS_PER_HOUR=40
AGENT_TURN_TIMEOUT_MS=60000
AGENT_AUDIO_MAX_SECONDS=120
AGENT_AUDIO_FALLBACK_BYTES=2097152
AGENT_IMAGE_MAX_BYTES=5242880
AGENT_IMAGES_PER_TURN=3
AGENT_TOTAL_MEDIA_BYTES=10485760

# Firebase Admin Configuration
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Admin WhatsApp Notifications
ADMIN_WHATSAPP_PHONE=595981234567

# Datos Bancarios para Transferencias (fuente única para mensajes y PDF)
BANK_NAME=ueno bank
BANK_ACCOUNT_HOLDER=SILVIA ANALIA ZIMARDI MAYEREGGER
BANK_DOCUMENT_ID=4180821
BANK_ACCOUNT_NUMBER=6192151586
BANK_CURRENCY=Gs
BANK_ALIAS=+595987305945 (celular)

# Cloudinary - Subida Firmada de Personalizaciones
CLOUDINARY_CLOUD_NAME=dzgy4q...
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here
CLOUDINARY_FOLDER=hodie-tienda/customizations

